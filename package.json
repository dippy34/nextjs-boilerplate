{
  "name": "space-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "A real-time, seamless, scale-free universe explorer (SpaceEngine-style) built on real astronomical catalogs and deterministic procedural generation.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data": "bash pipeline/run_all.sh",
    "verify": "node scripts/verify.mjs http://127.0.0.1:5173/ screenshots",
    "verify:interact": "node scripts/interact.mjs http://127.0.0.1:5173/ screenshots",
    "verify:vr": "node scripts/vr.mjs http://127.0.0.1:5173/ screenshots",
    "deploy": "bash scripts/deploy-pages.sh",
    "verify:game": "node scripts/game.mjs http://127.0.0.1:5173/ screenshots"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "iwer": "^2.5.0",
    "typescript": "5.9",
    "vite": "^8.3.2",
    "vitest": "^3.2.7"
  }
}
