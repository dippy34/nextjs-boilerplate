    "test": "node --test --experimental-strip-types tests/",
    "data": "bash pipeline/run_all.sh"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@types/three": "^0.186.0",
    "typescript": "5.9",
    "vite": "^8.3.2"
  }
}
